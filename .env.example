# NEST — environment template. Copy to .env and fill in. Never commit real secrets.

# Database (SQLite on this platform; Supabase Postgres URL in production)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Session cookie signing (any long random string; required)
SESSION_SECRET=dev-only-change-me

# Demo mode: exposes the five seeded demo profiles for the role switcher (1 = on)
DEMO_MODE=1

# M-Pesa Daraja. MPESA_MODE=sim fabricates a full Daraja-shaped flow locally
# (clearly labelled in the UI). MPESA_MODE=live calls the real API.
MPESA_MODE=sim
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_URL=https://example.com/api/mpesa/callback

# Notification providers (provider-agnostic layer; dev adapter when empty)
SMS_PROVIDER=dev
SMS_API_KEY=
WHATSAPP_PROVIDER=dev
WHATSAPP_API_KEY=

# Supabase (publishable/anon values are public by design; service key stays secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
